{
  "info": {
    "name": "Integrante 3 - Gestión de competencias",
    "description": "Coleccion Postman para HU-GC-02/03/04/05/06 (Integrante 3). Una peticion por metodo por carpeta; editar URL/body para variantes del mismo metodo. Precondiciones: baseUrl/token en environment, deporte/equipos/TeamSport y torneo existentes. GC-01 soporta sportId; GC-02 valida TeamSport(teamId,tournament.sportId). runId se genera automaticamente.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "token",
      "value": "",
      "type": "string",
      "description": "JWT pegado manualmente (ms_security tiene 2FA)."
    },
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api/v1",
      "type": "string",
      "description": "URL base de ms_sports."
    },
    {
      "key": "runId",
      "value": "",
      "type": "string",
      "description": "Se genera automaticamente en prerequest."
    },
    {
      "key": "tournamentId",
      "value": "1",
      "type": "string",
      "description": "ID de torneo existente con sportId definido y ventana de inscripcion abierta para GC-02."
    },
    {
      "key": "teamId",
      "value": "1",
      "type": "string",
      "description": "ID de equipo existente asociado al deporte del torneo (TeamSport) para GC-02."
    },
    {
      "key": "homeTeamId",
      "value": "1",
      "type": "string",
      "description": "ID equipo local inscrito en el torneo; para GC-06 en fase GROUP debe pertenecer al grupo de la fase."
    },
    {
      "key": "awayTeamId",
      "value": "2",
      "type": "string",
      "description": "ID equipo visitante inscrito en el torneo; distinto de homeTeamId."
    },
    {
      "key": "phaseId",
      "value": "1",
      "type": "string",
      "description": "ID de fase existente del torneo (GROUP o FINAL segun caso)."
    },
    {
      "key": "groupId",
      "value": "1",
      "type": "string",
      "description": "Se actualiza al crear grupo; tambien sirve para endpoints de teams de grupo."
    },
    {
      "key": "finalId",
      "value": "1",
      "type": "string",
      "description": "Se actualiza al crear fase final."
    },
    {
      "key": "matchId",
      "value": "1",
      "type": "string",
      "description": "Se actualiza al crear partido."
    },
    {
      "key": "sportId",
      "value": "1",
      "type": "string",
      "description": "ID de deporte existente. Usar GET /sports?all=true para obtener uno."
    }
  ],
  "item": [
    {
      "name": "Deportes",
      "description": "GD-01 soporte. Una peticion por metodo; editar URL/body para variantes. Variantes GET: {{baseUrl}}/sports/{{sportId}}, {{baseUrl}}/sports/{{sportId}}/subsports. Variante PATCH: {{baseUrl}}/sports/{{sportId}}/activate. Filtros GET: ?active=true&all=true&name=&parentSportId=.",
      "item": [
        {
          "name": "Create sport (POST)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/sports",
            "description": "Crea deporte. Body: name, description?, parentSportId?. Guarda sportId.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sport-{{runId}}\",\n  \"description\": \"Sport description\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201 Created', function () { pm.response.to.have.status(201); });",
                  "const body = pm.response.json();",
                  "pm.test('Returns created sport', function () { pm.expect(body.id).to.be.a('number'); pm.collectionVariables.set('sportId', String(body.id)); });"
                ]
              }
            }
          ]
        },
        {
          "name": "List sports (GET)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/sports?all=true",
            "description": "Lista deportes. Variantes: GET {{baseUrl}}/sports/{{sportId}}, GET {{baseUrl}}/sports/{{sportId}}/subsports?all=true."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('Returns array', function () { pm.expect(pm.response.json()).to.be.an('array'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Update sport (PUT)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/sports/{{sportId}}",
            "description": "Actualiza deporte (PUT reemplazo completo). Enviar name, description, parentSportId.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sport-Updated-{{runId}}\",\n  \"description\": \"Updated description\",\n  \"parentSportId\": null\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('Returns updated sport', function () { pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get('sportId'))); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Deactivate sport (PATCH)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/sports/{{sportId}}/deactivate",
            "description": "Desactiva deporte. Variante mismo metodo: PATCH {{baseUrl}}/sports/{{sportId}}/activate."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('Sport is inactive', function () { pm.expect(pm.response.json().active).to.eql(false); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete sport (DELETE)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/sports/{{sportId}}",
            "description": "Elimina deporte. 204 si no tiene dependencias; 409 INVALID_STATE si tiene subdeportes/equipos/torneos asociados."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 204 No Content', function () { pm.response.to.have.status(204); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Equipos",
      "description": "GD-02 soporte. Una peticion por metodo; editar URL/body para variantes. Variantes GET: {{baseUrl}}/teams/{{teamId}}, {{baseUrl}}/teams/reports/active-by-city, {{baseUrl}}/teams?active=false. Variantes PATCH: {{baseUrl}}/teams/{{teamId}}/activate, {{baseUrl}}/teams/{{teamId}}/deactivate.",
      "item": [
        {
          "name": "Create team (POST)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/teams",
            "description": "Crea equipo. Body: name, city, contactEmail, foundedYear?. Guarda teamId.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Team-{{runId}}\",\n  \"city\": \"Cali\",\n  \"contactEmail\": \"team-{{runId}}@example.com\",\n  \"foundedYear\": 2000\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201 Created', function () { pm.response.to.have.status(201); });",
                  "const body = pm.response.json();",
                  "pm.test('Returns created team', function () { pm.expect(body.id).to.be.a('number'); pm.collectionVariables.set('teamId', String(body.id)); });"
                ]
              }
            }
          ]
        },
        {
          "name": "List teams (GET)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/teams",
            "description": "Lista equipos. Variantes: GET {{baseUrl}}/teams/{{teamId}}, GET {{baseUrl}}/teams?active=false, GET {{baseUrl}}/teams/reports/active-by-city."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('Returns array', function () { pm.expect(pm.response.json()).to.be.an('array'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Update team (PATCH)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/teams/{{teamId}}",
            "description": "Actualiza equipo (PATCH parcial). Campos permitidos: name, city, contactEmail, foundedYear. Variantes PATCH: /teams/{{teamId}}/activate, /teams/{{teamId}}/deactivate.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"city\": \"Updated City\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('Returns updated team', function () { pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get('teamId'))); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete team (DELETE)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/teams/{{teamId}}",
            "description": "Elimina equipo. 200 con mensaje o 204 segun implementacion; 409 si tiene asociaciones."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 or 204', function () { pm.expect([200,204]).to.include(pm.response.code); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "GD-03 Team-Sports",
      "description": "Asociacion equipo-deporte (GD-03). Precondicion para GC-02: crear TeamSport antes de inscribir equipo en torneo del mismo deporte.",
      "item": [
        {
          "name": "Associate team sport (POST)",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/teams/{{teamId}}/sports/{{sportId}}",
            "description": "Asocia equipo con deporte. 201/200 segun implementacion; 409 si ya existe o estado invalido."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200/201', function(){ pm.expect([200,201]).to.include(pm.response.code); });"
                ]
              }
            }
          ]
        },
        {
          "name": "List team sports (GET)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/teams/{{teamId}}/sports",
            "description": "Lista deportes asociados al equipo. Variante: {{baseUrl}}/sports/{{sportId}}/teams?active=true."
          }
        },
        {
          "name": "List sport teams (GET)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/sports/{{sportId}}/teams",
            "description": "Lista equipos asociados al deporte. Variante con ?active=true."
          }
        },
        {
          "name": "Dissociate team sport (DELETE)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/teams/{{teamId}}/sports/{{sportId}}",
            "description": "Elimina asociacion. 204 si existe; 404 si no existe."
          }
        }
      ]
    },
    {
      "name": "Torneos",
      "description": "GC-01 soporte. Una peticion por metodo; editar URL/body para variantes. DTO actual: name, sportId, startDate, enrollmentDeadline. Variantes GET: {{baseUrl}}/tournaments/{{tournamentId}}, {{baseUrl}}/tournaments/reports/open-enrollment, {{baseUrl}}/tournaments/{{tournamentId}}/overview, {{baseUrl}}/tournaments/{{tournamentId}}/phases.",
      "item": [
        {
          "name": "Create tournament (POST)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/tournaments",
            "description": "Crea torneo GC-01. Requiere sportId activo. Guarda tournamentId.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Tournament-{{runId}}\",\n  \"sportId\": {{sportId}},\n  \"startDate\": \"2030-06-01\",\n  \"enrollmentDeadline\": \"2030-05-01\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201 Created', function () { pm.response.to.have.status(201); });",
                  "const body = pm.response.json();",
                  "pm.test('Returns created tournament', function () { pm.expect(body.id).to.be.a('number'); pm.collectionVariables.set('tournamentId', String(body.id)); });"
                ]
              }
            }
          ]
        },
        {
          "name": "List tournaments (GET)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/tournaments",
            "description": "Lista torneos. Variantes GET: /tournaments/{{tournamentId}}, /tournaments/reports/open-enrollment, /tournaments/{{tournamentId}}/overview, /tournaments/{{tournamentId}}/phases."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('Returns array', function () { pm.expect(pm.response.json()).to.be.an('array'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Update tournament (PUT)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/tournaments/{{tournamentId}}",
            "description": "Actualiza torneo (PUT reemplazo completo). DTO: name, sportId, startDate, enrollmentDeadline.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Tournament-Updated-{{runId}}\",\n  \"sportId\": {{sportId}},\n  \"startDate\": \"2030-06-01\",\n  \"enrollmentDeadline\": \"2030-05-01\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
