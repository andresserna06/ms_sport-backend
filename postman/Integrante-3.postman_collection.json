    {
      "name": "FLOW GC-06 Verificar fase con torneo",
      "description": "Flujo manual para diagnosticar \"La fase X no tiene un torneo asociado\". Precondicion: equipos activos, TeamSport creado (GD-03), inscritos en torneo (GC-02) y asignados al grupo (GC-04).",
      "item": [
        {
          "name": "Check phase (GET)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/phases/{{phaseId}}",
            "description": "Paso 1: verificar fase. Si tournamentId es null, la fase es huerfana y matches devolvera 409 INVALID_STATE. Variante: GET {{baseUrl}}/phases/1. Para listar fases por torneo: GET {{baseUrl}}/tournaments/{{tournamentId}}/phases."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 OK', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.test('Phase has tournamentId', function () { pm.expect(body).to.have.property('tournamentId'); if(body.tournamentId !== null){ pm.collectionVariables.set('tournamentId', String(body.tournamentId)); } });",
                  "pm.test('Diagnostico: fase asociada a torneo', function () { pm.expect(body.tournamentId, 'La fase no tiene torneo asociado; crea/usa una fase con tournamentId').to.not.eql(null); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Create tournament (POST)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/tournaments",
            "description": "Crea torneo GC-01. Requiere sportId activo. Guarda tournamentId.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Tournament-{{runId}}\",\n  \"sportId\": {{sportId}},\n  \"startDate\": \"2030-06-01\",\n  \"enrollmentDeadline\": \"2030-05-01\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201 Created', function () { pm.response.to.have.status(201); });",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('tournamentId', String(body.id));",
                  "pm.test('Tournament id saved', function () { pm.expect(body.id).to.be.a('number'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Create group phase (POST)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/groups",
            "description": "Paso 3: crea grupo/fase asociado al torneo. Guarda phaseId/groupId. Verifica luego con GET /phases/{{phaseId}} que tournamentId no sea null.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Group-Flow-{{runId}}\",\n  \"order\": 1,\n  \"tournamentId\": {{tournamentId}}\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
