                  "  pm.expect(pm.response.json()).to.be.an('array');",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Get phase by id (GET)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/phases/{{phaseId}}",
            "description": "Obtiene detalle de fase por id."
          }
        },
        {
          "name": "List tournament phases alias (GET)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/tournaments/{{tournamentId}}/phases",
            "description": "Alias por torneo. Equivalente a /phases?tournamentId=."
          }
        }
      ],
      "description": "HU-GC-03. Base de fases es read/report; creacion/edicion se hace en GC-04 (/groups) y GC-05 (/finals). Variante GET: {{baseUrl}}/phases/{{phaseId}}, {{baseUrl}}/phases/reports/count-by-type o {{baseUrl}}/tournaments/{{tournamentId}}/phases."
    },
    {
      "name": "GC-04 Grupos",
      "item": [
        {
          "name": "Create group (POST)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Group-{{runId}}\",\n  \"order\": 1,\n  \"tournamentId\": {{tournamentId}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/groups",
            "description": "Crea grupo/fase GROUP. Variante POST: asignar equipo a grupo con /groups/{{groupId}}/teams/{{teamId}} sin body; requiere equipo inscrito en el torneo del grupo (R11), si no 409 INVALID_STATE."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('runId', String(Date.now()));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201 Created', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test('Returns a group phase', function () {",
                  "  pm.expect(body.id).to.be.a('number');",
                  "  pm.expect(body.phaseType).to.eql('GROUP');",
                  "});",
