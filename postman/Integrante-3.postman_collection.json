                  "pm.collectionVariables.set('groupId', String(body.id));",
                  "pm.test('Group has tournamentId', function () { pm.expect(body.tournamentId).to.eql(Number(pm.collectionVariables.get('tournamentId'))); });"
                ]
              }
            }
          ]
        },
