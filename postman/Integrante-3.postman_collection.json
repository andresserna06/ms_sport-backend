{
  "info": {
    "name": "Integrante 3 - Gestión de competencias",
    "description": "Coleccion Postman para HU-GC-02/03/04/05/06 (Integrante 3). Una peticion por metodo por carpeta; editar URL/body para variantes del mismo metodo. Precondiciones: baseUrl/token en environment, torneo/equipos/fase existentes. GC-02: el torneo debe tener sportId y debe existir asociacion TeamSport(teamId,sportId); si GD-03 no esta implementada en API, crearla por seed/SQL antes de probar. runId se genera automaticamente.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "token",
      "value": "",
      "type": "string",
      "description": "JWT pegado manualmente (ms_security tiene 2FA)."
    },
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api/v1",
      "type": "string",
      "description": "URL base de ms_sports."
    },
    {
      "key": "runId",
      "value": "",
      "type": "string",
      "description": "Se genera automaticamente en prerequest."
    },
    {
      "key": "tournamentId",
      "value": "1",
      "type": "string",
      "description": "ID de torneo existente con sportId definido y ventana de inscripcion abierta para GC-02."
    },
    {
      "key": "teamId",
      "value": "1",
      "type": "string",
      "description": "ID de equipo existente asociado al deporte del torneo (TeamSport) para GC-02."
    },
    {
      "key": "homeTeamId",
      "value": "1",
      "type": "string",
      "description": "ID equipo local inscrito en el torneo; para GC-06 en fase GROUP debe pertenecer al grupo de la fase."
    },
    {
      "key": "awayTeamId",
      "value": "2",
      "type": "string",
      "description": "ID equipo visitante inscrito en el torneo; distinto de homeTeamId."
    },
    {
      "key": "phaseId",
      "value": "1",
      "type": "string",
      "description": "ID de fase existente del torneo (GROUP o FINAL segun caso)."
    },
    {
      "key": "groupId",
      "value": "1",
      "type": "string",
      "description": "Se actualiza al crear grupo; tambien sirve para endpoints de teams de grupo."
    },
    {
      "key": "finalId",
      "value": "1",
      "type": "string",
      "description": "Se actualiza al crear fase final."
    },
    {
      "key": "matchId",
      "value": "1",
      "type": "string",
      "description": "Se actualiza al crear partido."
    }
  ],
  "item": [
    {
      "name": "GC-02 Inscripciones",
      "item": [
        {
          "name": "Create registration (POST)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"teamId\": {{teamId}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/tournaments/{{tournamentId}}/registrations",
            "description": "Crea inscripcion. Precondicion: TeamSport existente para teamId y sportId del torneo. Retorna 201 con RegistrationResponseDto."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201 Created', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test('Returns the created registration', function () {",
                  "  pm.expect(body.id).to.be.a('number');",
                  "  pm.expect(body.team.id).to.eql(Number(pm.collectionVariables.get('teamId')));",
                  "});",
                  "pm.collectionVariables.set('registrationId', body.id);"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "List tournament registrations (GET)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/tournaments/{{tournamentId}}/registrations",
            "description": "Lista equipos inscritos en torneo. Variante mismo metodo: GET {{baseUrl}}/teams/{{teamId}}/tournaments."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 OK', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Returns a registration list', function () {",
                  "  pm.expect(pm.response.json()).to.be.an('array');",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Remove registration (DELETE)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/tournaments/{{tournamentId}}/registrations/{{teamId}}",
            "description": "Retira inscripcion. 204 si OK; 409 si torneo iniciado/cerrado o equipo asignado a grupo/con partidos."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 204 No Content', function () {",
                  "  pm.response.to.have.status(204);",
                  "});"
                ]
              }
            }
          ],
          "response": []
        }
      ],
      "description": "HU-GC-02. Endpoints cubiertos por metodo: POST/GET/DELETE en /tournaments/:tournamentId/registrations. Variante GET mismo metodo (editar URL): /teams/{{teamId}}/tournaments. Punto 2: create valida TeamSport(teamId,tournament.sportId); si falta asociacion o torneo sin sportId retorna 409 INVALID_STATE."
    },
    {
      "name": "GC-03 Fases",
      "item": [
        {
          "name": "List tournament phases (GET)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/phases?tournamentId={{tournamentId}}",
            "description": "Lista fases por tournamentId. Editar query para filtrar o usar /phases/{{phaseId}}."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 OK', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Returns a phase list', function () {",
                  "  pm.expect(pm.response.json()).to.be.an('array');",
                  "});"
                ]
              }
            }
          ],
          "response": []
        }
      ],
      "description": "HU-GC-03. Base de fases es read/report; creacion/edicion se hace en GC-04 (/groups) y GC-05 (/finals). Variante GET: {{baseUrl}}/phases/{{phaseId}} o {{baseUrl}}/phases/reports/count-by-type."
    },
    {
      "name": "GC-04 Grupos",
      "item": [
        {
          "name": "Create group (POST)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Group-{{runId}}\",\n  \"order\": 1,\n  \"tournamentId\": {{tournamentId}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/groups",
            "description": "Crea grupo/fase GROUP. Variante POST: asignar equipo a grupo con /groups/{{groupId}}/teams/{{teamId}} sin body."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('runId', String(Date.now()));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201 Created', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test('Returns a group phase', function () {",
                  "  pm.expect(body.id).to.be.a('number');",
                  "  pm.expect(body.phaseType).to.eql('GROUP');",
                  "});",
                  "pm.collectionVariables.set('groupId', body.id);"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "List groups (GET)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/groups?tournamentId={{tournamentId}}",
            "description": "Lista grupos por torneo. Variante GET: /groups/{{groupId}} o /groups/{{groupId}}/teams."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 OK', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Returns a group list', function () {",
                  "  pm.expect(pm.response.json()).to.be.an('array');",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Update group (PATCH)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Group-Updated-{{runId}}\",\n  \"order\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/groups/{{groupId}}",
            "description": "Actualiza name/order del grupo."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 OK', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test('Returns the updated group', function () {",
                  "  pm.expect(body.id).to.eql(Number(pm.collectionVariables.get('groupId')));",
                  "  pm.expect(body.phaseType).to.eql('GROUP');",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Delete group (DELETE)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/groups/{{groupId}}",
            "description": "Elimina grupo. 200 con mensaje si no tiene partidos; 409 INVALID_STATE si tiene partidos. Variante DELETE: /groups/{{groupId}}/teams/{{teamId}} devuelve 204."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 OK', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Returns a deletion message', function () {",
                  "  pm.expect(pm.response.json().message).to.be.a('string');",
                  "});"
                ]
              }
            }
          ],
          "response": []
        }
      ],
      "description": "HU-GC-04. CRUD basico de grupos. Variantes mismo metodo: GET {{baseUrl}}/groups/{{groupId}} o {{baseUrl}}/groups/{{groupId}}/teams; POST {{baseUrl}}/groups/{{groupId}}/teams/{{teamId}} (asignar equipo); DELETE {{baseUrl}}/groups/{{groupId}}/teams/{{teamId}} (quitar equipo, 204)."
    },
    {
      "name": "GC-05 Fases finales",
      "item": [
        {
          "name": "Create final phase (POST)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Final-{{runId}}\",\n  \"order\": 2,\n  \"tournamentId\": {{tournamentId}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/finals",
            "description": "Crea fase FINAL."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('runId', String(Date.now()));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201 Created', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test('Returns a final phase', function () {",
                  "  pm.expect(body.id).to.be.a('number');",
                  "  pm.expect(body.phaseType).to.eql('FINAL');",
                  "});",
                  "pm.collectionVariables.set('finalId', body.id);"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "List final phases (GET)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/finals?tournamentId={{tournamentId}}",
            "description": "Lista fases finales por torneo. Variante GET: /finals/{{finalId}}."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 OK', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Returns a final phase list', function () {",
                  "  pm.expect(pm.response.json()).to.be.an('array');",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Update final phase (PATCH)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Final-Updated-{{runId}}\",\n  \"order\": 2\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/finals/{{finalId}}",
            "description": "Actualiza name/order de fase final."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 OK', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test('Returns the updated final phase', function () {",
                  "  pm.expect(body.id).to.eql(Number(pm.collectionVariables.get('finalId')));",
                  "  pm.expect(body.phaseType).to.eql('FINAL');",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Delete final phase (DELETE)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/finals/{{finalId}}",
            "description": "Elimina fase final. 200 con mensaje si no tiene partidos; 409 si tiene partidos."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 OK', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Returns a deletion message', function () {",
                  "  pm.expect(pm.response.json().message).to.be.a('string');",
                  "});"
                ]
              }
            }
          ],
          "response": []
        }
      ],
      "description": "HU-GC-05. CRUD basico de fases finales. Variante GET: {{baseUrl}}/finals/{{finalId}}."
    },
    {
      "name": "GC-06 Partidos",
      "item": [
        {
          "name": "Create match (POST)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"scheduledAt\": \"2030-01-15T10:00:00.000Z\",\n  \"homeTeamId\": {{homeTeamId}},\n  \"awayTeamId\": {{awayTeamId}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/phases/{{phaseId}}/matches",
            "description": "Crea partido en fase. En GROUP home/away son obligatorios y deben estar inscritos y pertenecer al grupo. En FINAL pueden ser null."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201 Created', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test('Returns a scheduled match', function () {",
                  "  pm.expect(body.id).to.be.a('number');",
                  "  pm.expect(body.phaseId).to.eql(Number(pm.collectionVariables.get('phaseId')));",
                  "  pm.expect(body.status).to.eql('SCHEDULED');",
                  "});",
                  "pm.collectionVariables.set('matchId', body.id);"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "List matches (GET)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/matches",
            "description": "Lista partidos. Variantes GET: /phases/{{phaseId}}/matches o /matches/{{matchId}}."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 OK', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Returns a match list', function () {",
                  "  pm.expect(pm.response.json()).to.be.an('array');",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Update match (PUT)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"scheduledAt\": \"2030-01-15T11:00:00.000Z\",\n  \"homeTeamId\": {{homeTeamId}},\n  \"awayTeamId\": {{awayTeamId}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/matches/{{matchId}}",
            "description": "Actualiza partido SCHEDULED. No enviar status/homeScore/awayScore; usar GC-07 para resultado/finalizacion."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 OK', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test('Returns the updated match', function () {",
                  "  pm.expect(body.id).to.eql(Number(pm.collectionVariables.get('matchId')));",
                  "  pm.expect(body.status).to.eql('SCHEDULED');",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Delete match (DELETE)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/matches/{{matchId}}",
            "description": "Elimina partido SCHEDULED sin dependencias. Respuesta 204."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 204 No Content', function () {",
                  "  pm.response.to.have.status(204);",
                  "});"
                ]
              }
            }
          ],
          "response": []
        }
      ],
      "description": "HU-GC-06. Contrato actual: POST/GET por fase, GET/PUT/DELETE por match. Update generico no acepta status/homeScore/awayScore (GC-07). Variantes GET mismo metodo: {{baseUrl}}/phases/{{phaseId}}/matches, {{baseUrl}}/matches/{{matchId}}."
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('runId')) {",
          "  pm.collectionVariables.set('runId', String(Date.now()));",
          "}"
        ]
      }
    }
  ]
}
