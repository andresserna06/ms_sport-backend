    {
      "name": "GC-06 Partidos",
      "item": [
        {
          "name": "Create match (POST)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"scheduledAt\": \"2030-01-15T10:00:00.000Z\",\n  \"homeTeamId\": {{homeTeamId}},\n  \"awayTeamId\": {{awayTeamId}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/phases/{{phaseId}}/matches",
            "description": "La fase y ambos equipos deben existir; los equipos deben estar inscritos en el torneo de la fase. Sustituye scheduledAt y los IDs por datos válidos. La creación emite el evento de correo, pero el partido debe guardarse aunque ms_notificaciones no esté disponible."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201 Created', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test('Returns a scheduled match', function () {",
                  "  pm.expect(body.id).to.be.a('number');",
                  "  pm.expect(body.phaseId).to.eql(Number(pm.collectionVariables.get('phaseId')));",
                  "  pm.expect(body.status).to.eql('SCHEDULED');",
                  "});",
                  "pm.collectionVariables.set('matchId', body.id);"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "List matches (GET)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/matches",
            "description": "Para consultar un partido por ID, cambia la URL a /matches/{{matchId}}. Para listar por fase, cambia a /phases/{{phaseId}}/matches."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 OK', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Returns a match list', function () {",
                  "  pm.expect(pm.response.json()).to.be.an('array');",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Update match (PUT)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"scheduledAt\": \"2030-01-15T11:00:00.000Z\",\n  \"homeTeamId\": {{homeTeamId}},\n  \"awayTeamId\": {{awayTeamId}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/matches/{{matchId}}",
            "description": "Solo se puede actualizar un partido en estado SCHEDULED. Los campos del body son opcionales."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 OK', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test('Returns the updated match', function () {",
                  "  pm.expect(body.id).to.eql(Number(pm.collectionVariables.get('matchId')));",
                  "  pm.expect(body.status).to.eql('SCHEDULED');",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Delete match (DELETE)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/matches/{{matchId}}",
            "description": "Solo se elimina si está SCHEDULED y no tiene anotaciones registradas."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 204 No Content', function () {",
                  "  pm.response.to.have.status(204);",
                  "});"
                ]
              }
            }
          ],
          "response": []
        }
      ]
