                  "pm.test('Status 200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('Returns updated tournament', function () { pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get('tournamentId'))); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete tournament (DELETE)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/tournaments/{{tournamentId}}",
            "description": "Elimina torneo. Comportamiento actual GC-01: 200 con mensaje si elimina; puede fallar por dependencias/FK."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 or 204', function () { pm.expect([200,204]).to.include(pm.response.code); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "GC-02 Inscripciones",
      "item": [
        {
          "name": "Create registration (POST)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"teamId\": {{teamId}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/tournaments/{{tournamentId}}/registrations",
            "description": "Crea inscripcion. Precondicion: TeamSport existente para teamId y sportId del torneo. Retorna 201 con RegistrationResponseDto."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201 Created', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test('Returns the created registration', function () {",
                  "  pm.expect(body.id).to.be.a('number');",
                  "  pm.expect(body.team.id).to.eql(Number(pm.collectionVariables.get('teamId')));",
                  "});",
                  "pm.collectionVariables.set('registrationId', body.id);"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "List tournament registrations (GET)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/tournaments/{{tournamentId}}/registrations",
            "description": "Lista equipos inscritos en torneo. Variante mismo metodo: GET {{baseUrl}}/teams/{{teamId}}/tournaments."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 OK', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Returns a registration list', function () {",
                  "  pm.expect(pm.response.json()).to.be.an('array');",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Remove registration (DELETE)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/tournaments/{{tournamentId}}/registrations/{{teamId}}",
            "description": "Retira inscripcion. 204 si OK; 409 si torneo iniciado/cerrado o equipo asignado a grupo/con partidos."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 204 No Content', function () {",
                  "  pm.response.to.have.status(204);",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "List team tournaments (GET)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/teams/{{teamId}}/tournaments",
            "description": "Lista torneos donde el equipo est? inscrito. Variante ?til para validar GC-02."
          }
        }
      ],
      "description": "HU-GC-02. Endpoints por metodo: POST/GET/DELETE en /tournaments/:tournamentId/registrations. Variante GET: /teams/{{teamId}}/tournaments. Precondicion: torneo con sportId y TeamSport(teamId,sportId) existente (GD-03)."
    },
    {
      "name": "GC-03 Fases",
      "item": [
        {
          "name": "List tournament phases (GET)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/phases?tournamentId={{tournamentId}}",
            "description": "Lista fases por tournamentId. Variantes GET: /phases/{{phaseId}}, /phases/reports/count-by-type, /tournaments/{{tournamentId}}/phases."
          },
          "event": [
            {
              "listen": "test",
              "script": {
