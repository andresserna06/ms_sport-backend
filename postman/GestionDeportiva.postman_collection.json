{
  "info": {
    "name": "GestionDeportiva - ms_sports",
    "description": "Colección de pruebas de integración para ms_sports (HU-GD-06 Skills).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('runId')) {",
          "  pm.collectionVariables.set('runId', String(Date.now()));",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "GD-06 Habilidades",
      "item": [
        {
          "name": "Demo CRUD (5 endpoints)",
          "item": [
            {
              "name": "Crear habilidad",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"Salto vertical\",\n  \"description\": \"Capacidad de impulso aéreo para bloqueos, rebotes y remates\"\n}"
                },
                "url": "{{baseUrl}}/skills"
              }
            },
            {
              "name": "Listar habilidades",
              "request": {
                "method": "GET",
                "header": [],
                "url": "{{baseUrl}}/skills"
              }
            },
            {
              "name": "Consultar habilidad por id",
              "request": {
                "method": "GET",
                "header": [],
                "url": "{{baseUrl}}/skills/5"
              }
            },
            {
              "name": "Actualizar habilidad",
              "request": {
                "method": "PUT",
                "header": [
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"Salto vertical\",\n  \"description\": \"Capacidad de impulso y alcance aéreo en jugadas defensivas y ofensivas\"\n}"
                },
                "url": "{{baseUrl}}/skills/5"
              }
            },
            {
              "name": "Eliminar habilidad",
              "request": {
                "method": "DELETE",
                "header": [],
                "url": "{{baseUrl}}/skills/5"
              }
            }
          ]
        },
        {
          "name": "Pruebas automatizadas (22 casos)",
          "item": [
            {
              "name": "TC-GD06-01 Crear habilidad (éxito con trim)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"  Velocidad-{{runId}}  \",\n  \"description\": \"  Capacidad de desplazamiento rápido en cancha  \"\n}"
            },
            "url": "{{baseUrl}}/skills"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201 Created', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "const body = pm.response.json();",
                  "const expectedName = `Velocidad-${pm.collectionVariables.get('runId')}`;",
                  "pm.test('Devuelve DTO con id y campos recortados', function () {",
                  "  pm.expect(body.id).to.be.a('number');",
                  "  pm.expect(body.name).to.eql(expectedName);",
                  "  pm.expect(body.description).to.eql('Capacidad de desplazamiento rápido en cancha');",
                  "});",
                  "pm.collectionVariables.set('skillId', body.id);",
                  "pm.collectionVariables.set('skillName', body.name);"
                ]
              }
            }
          ]
        },
        {
          "name": "TC-GD06-02 Crear segunda habilidad (para prueba de duplicado en PUT)",
          "request": {
