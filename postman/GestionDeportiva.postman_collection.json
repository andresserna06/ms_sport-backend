                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Status 200 OK', function () {",
                      "  pm.response.to.have.status(200);",
                      "});",
                      "const body = pm.response.json();",
                      "const id1 = Number(pm.collectionVariables.get('playerId'));",
                      "const id2 = Number(pm.collectionVariables.get('playerId2'));",
                      "pm.test('Contiene los jugadores creados ordenados por id', function () {",
                      "  pm.expect(body).to.be.an('array');",
                      "  const ids = body.map((p) => p.id);",
                      "  pm.expect(ids).to.include(id1);",
                      "  pm.expect(ids).to.include(id2);",
                      "  pm.expect(ids.indexOf(id1)).to.be.below(ids.indexOf(id2));",
                      "});"
                    ]
                  }
                }
              ]
