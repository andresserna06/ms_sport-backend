{
  "info": {
    "name": "GestionDeportiva - ms_sports (GD-04 Jugadores)",
    "description": "Colección de pruebas de integración y demo CRUD para HU-GD-04 (Players).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('runId')) {",
          "  const now = Date.now();",
          "  const runId = String(now).slice(-6);",
          "  const baseUserId = 100000 + (now % 800000);",
          "  pm.collectionVariables.set('runId', runId);",
          "  pm.collectionVariables.set('testUserId1', String(baseUserId));",
          "  pm.collectionVariables.set('testUserId2', String(baseUserId + 1));",
          "  pm.collectionVariables.set('testUserId3', String(baseUserId + 2));",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "GD-04 Jugadores",
      "item": [
        {
          "name": "Demo CRUD (7 endpoints)",
          "item": [
            {
              "name": "Crear jugador",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"userId\": 1,\n  \"document\": \"1053812345\",\n  \"position\": \"Delantero\",\n  \"jerseyNumber\": 9\n}"
                },
                "url": "{{baseUrl}}/players"
              }
            },
            {
              "name": "Listar jugadores activos",
              "request": {
                "method": "GET",
                "header": [],
                "url": "{{baseUrl}}/players"
              }
            },
            {
              "name": "Consultar jugador por id",
              "request": {
                "method": "GET",
                "header": [],
                "url": "{{baseUrl}}/players/1"
              }
            },
            {
              "name": "Actualizar jugador",
              "request": {
                "method": "PUT",
                "header": [
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"userId\": 1,\n  \"document\": \"1053812345\",\n  \"position\": \"Mediocampista\",\n  \"jerseyNumber\": 10\n}"
                },
                "url": "{{baseUrl}}/players/1"
              }
            },
            {
              "name": "Desactivar jugador",
              "request": {
                "method": "PATCH",
                "header": [],
                "url": "{{baseUrl}}/players/1/deactivate"
              }
            },
            {
              "name": "Activar jugador",
              "request": {
                "method": "PATCH",
                "header": [],
                "url": "{{baseUrl}}/players/1/activate"
              }
            },
            {
              "name": "Eliminar jugador",
              "request": {
                "method": "DELETE",
                "header": [],
                "url": "{{baseUrl}}/players/1"
              }
            }
          ]
        },
        {
          "name": "Pruebas automatizadas (24 casos)",
          "item": [
            {
              "name": "TC-GD04-01 Crear jugador completo (éxito con trim)",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"userId\": {{testUserId1}},\n  \"document\": \"  CC-{{runId}}-1  \",\n  \"position\": \"  Delantero  \",\n  \"jerseyNumber\": 9\n}"
                },
                "url": "{{baseUrl}}/players"
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Status 201 Created', function () {",
                      "  pm.response.to.have.status(201);",
                      "});",
                      "const body = pm.response.json();",
                      "const expectedDoc = `CC-${pm.collectionVariables.get('runId')}-1`;",
                      "pm.test('Devuelve DTO con campos recortados y active=true', function () {",
                      "  pm.expect(body.id).to.be.a('number');",
                      "  pm.expect(body.userId).to.eql(Number(pm.collectionVariables.get('testUserId1')));",
                      "  pm.expect(body.document).to.eql(expectedDoc);",
                      "  pm.expect(body.position).to.eql('Delantero');",
                      "  pm.expect(body.jerseyNumber).to.eql(9);",
                      "  pm.expect(body.active).to.eql(true);",
                      "});",
                      "pm.collectionVariables.set('playerId', body.id);",
                      "pm.collectionVariables.set('playerUserId', body.userId);",
                      "pm.collectionVariables.set('playerDocument', body.document);"
                    ]
                  }
                }
              ]
            },
