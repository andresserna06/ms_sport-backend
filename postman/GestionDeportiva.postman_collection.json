            "url": "{{baseUrl}}/skills"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201 Created', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test('Devuelve id y nombre esperado', function () {",
                  "  pm.expect(body.id).to.be.a('number');",
                  "  pm.expect(body.name).to.eql(`Resistencia-${pm.collectionVariables.get('runId')}`);",
                  "});",
                  "pm.collectionVariables.set('skillId2', body.id);",
                  "pm.collectionVariables.set('skillName2', body.name);",
                  "pm.collectionVariables.set('skillName2Upper', body.name.toUpperCase());"
                ]
              }
            }
          ]
        },
