              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 409 Conflict', function () {",
                  "  pm.response.to.have.status(409);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test('errorCase ALREADY_EXISTS', function () {",
                  "  pm.expect(body.errorCase).to.eql('ALREADY_EXISTS');",
                  "  pm.expect(body.message).to.be.a('string').and.not.be.empty;",
                  "});"
                ]
