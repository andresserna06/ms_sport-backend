                      "const body = pm.response.json();",
                      "pm.test('Campos opcionales en null y active=true', function () {",
                      "  pm.expect(body.id).to.be.a('number');",
                      "  pm.expect(body.position).to.eql(null);",
                      "  pm.expect(body.jerseyNumber).to.eql(null);",
                      "  pm.expect(body.active).to.eql(true);",
                      "});",
                      "pm.collectionVariables.set('playerId2', body.id);",
                      "pm.collectionVariables.set('playerUserId2', body.userId);",
                      "pm.collectionVariables.set('playerDocument2', body.document);",
                      "pm.collectionVariables.set('playerDocument2Lower', body.document ? body.document.toLowerCase() : '');"
                    ]
                  }
                }
