          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 OK', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const body = pm.response.json();",
                  "const id1 = Number(pm.collectionVariables.get('skillId'));",
                  "const id2 = Number(pm.collectionVariables.get('skillId2'));",
                  "pm.test('Devuelve arreglo con las habilidades creadas', function () {",
                  "  pm.expect(body).to.be.an('array');",
                  "  const ids = body.map((s) => s.id);",
                  "  pm.expect(ids).to.include(id1);",
                  "  pm.expect(ids).to.include(id2);",
                  "});"
                ]
              }
            }
          ]
